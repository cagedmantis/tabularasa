{
  "manifest_version": 3,
  "name": "Tabularasa",
  "version": "1.0.0",
  "description": "Chrome Tab Manager Extension",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Open Tabularasa"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}