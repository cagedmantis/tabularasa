{
  "manifest_version": 3,
  "name": "Tabularasa",
  "version": "1.0.0",
  "description": "An advanced Chrome Tab and Window Manager",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "tabGroups"
  ],
  "action": {
    "default_title": "Open Tabularasa"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}