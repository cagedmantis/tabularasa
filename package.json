{
  "name": "tabula-rasa",
  "version": "1.0.0",
  "description": "An advanced Chrome Tab and Window Manager",
  "scripts": {
    "test": "jest --config=tests/jest.config.js",
    "test:watch": "jest --config=tests/jest.config.js --watch",
    "test:coverage": "jest --config=tests/jest.config.js --coverage",
    "build": "echo 'No build step required - extension uses vanilla JS'",
    "lint": "eslint popup.js background.js",
    "clean": "rm -rf coverage dist"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "babel-jest": "^29.5.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0"
  },
  "babel": {
    "presets": ["@babel/preset-env"]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "webextensions": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 2020,
      "sourceType": "module"
    },
    "globals": {
      "chrome": "readonly"
    }
  },
  "keywords": [
    "chrome-extension",
    "tab-manager",
    "window-manager",
    "productivity"
  ],
  "author": "Tabula Rasa Extension",
  "license": "MIT",
  "private": true
}